# Leave VITE_API_BASE_URL empty: the page and the API must share an origin so that the
# session cookie is sent. In development the Vite proxy serves /api and /auth.
VITE_API_BASE_URL=

# Dev proxy only (never bundled into the browser build)
L1_API_TARGET=http://127.0.0.1:8080
# Optional scoped token (l1-agent token create --name dev --permission incidents.read).
# Leave empty to sign in through the page, or when the backend is in demo mode.
L1_API_TOKEN=

# Branding. All optional; defaults are neutral.
VITE_BRAND_PRODUCT=L1 Engineer Agent
VITE_BRAND_ORG=
VITE_BRAND_BANNER=
VITE_BRAND_LOGO=
VITE_BRAND_FOOTER=L1 Engineer Agent
