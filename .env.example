# ─── L1 Virtual Engineer Agent Configuration ─────────────────────────
# Copy this file to .env and fill in the values for your environment.
# NEVER commit real credentials. Use a secrets vault in production.

# ─── ServiceNow ──────────────────────────────────────────────────────
SERVICENOW_BASE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=api_user
SERVICENOW_PASSWORD=CHANGE_ME
SERVICENOW_POLL_INTERVAL=30
# Required. The poller only takes New incidents assigned to this group.
SERVICENOW_ASSIGNMENT_GROUP=L1-Support
SERVICENOW_SOP_TABLE=kb_knowledge
SERVICENOW_INCIDENT_TABLE=incident
SERVICENOW_TIMEOUT=30
# Resolution code sent when the agent resolves an incident. Must be a value your
# instance accepts; a stock instance rejects the Resolved state without one, and
# silently drops a value that is not in its Resolution code list. "Solution provided"
# is valid on current developer instances.
SERVICENOW_CLOSE_CODE=
# The group put on each change the agent opens. A stock instance will not move a
# change out of New without an assignment group. Leave empty when your standard
# change templates set one themselves.
SERVICENOW_CHANGE_ASSIGNMENT_GROUP=
# Connect demo mode (mock tool adapters, sample SOPs) to this instance for testing.
SERVICENOW_LIVE_IN_DEMO=false
# basic, or oauth. With oauth and no password the client credentials grant is used;
# with a user name and password as well, the password grant.
SERVICENOW_AUTH=basic
SERVICENOW_OAUTH_CLIENT_ID=
SERVICENOW_OAUTH_CLIENT_SECRET=
# Default: <base url>/oauth_token.do
SERVICENOW_OAUTH_TOKEN_URL=
# Before working a ticket the agent assigns it to this user (default: SERVICENOW_USERNAME)
# and leaves alone a ticket someone else already holds.
SERVICENOW_CLAIM=true
SERVICENOW_AGENT_USER=
SERVICENOW_PAGE_SIZE=100
SERVICENOW_MAX_PAGES=10

# ─── Credential references ───────────────────────────────────────────
# Any credential below can be given as a reference instead of a value, by adding
# _REF to its name. The value is then read when it is needed, so rotating it in
# the secrets backend takes effect without a restart. Forms:
#   vault:<path>/<field>   aws:<name>   file:/absolute/path   env:NAME
# Examples:
#   SERVICENOW_PASSWORD_REF=vault:servicenow/password
#   SPLUNK_TOKEN_REF=file:/run/secrets/splunk-token
# Directories that file: references may read from (path-separated). Empty: any.
SECRETS_FILE_ROOTS=

# ─── Knowledge sources (SOP drafts) ──────────────────────────────────
# Everything pulled from a source becomes a draft. A person submits it and a
# different person approves it before it can run.
# Seconds between syncs. 0: only on `l1-agent knowledge sync`.
KNOWLEDGE_SYNC_INTERVAL=0
KNOWLEDGE_SERVICENOW_KB=false
KNOWLEDGE_SERVICENOW_KB_QUERY=workflow_state=published
# https:// or ssh:// only. Reads *.json, *.md and *.txt under the path.
KNOWLEDGE_GIT_URL=
KNOWLEDGE_GIT_REF=main
KNOWLEDGE_GIT_PATH=
KNOWLEDGE_GIT_CACHE_DIR=
# KNOWLEDGE_GIT_TOKEN_REF=vault:git/token

# ─── Splunk ──────────────────────────────────────────────────────────
# Two interchangeable backends behind one guard:
#   mcp   the Splunk MCP Server app (Splunkbase 7931), at <splunk>:8089/services/mcp
#   rest  the REST search API on port 8089, for Splunk versions that cannot run the app
#   mock  canned results (what demo mode uses unless LIVE_ADAPTERS names splunk)
# Left empty: rest when SPLUNK_BASE_URL is set, otherwise mcp when SPLUNK_MCP_URL is.
SPLUNK_BACKEND=mcp

# MCP backend. SPLUNK_MCP_AUTH is the token the MCP app issues, with or without the
# leading "Bearer ". Prefer a reference: SPLUNK_MCP_AUTH_REF=file:/run/secrets/splunk-mcp
# On Windows do not set it with `setx`, which cuts values at 1024 characters; use
#   [Environment]::SetEnvironmentVariable('SPLUNK_MCP_AUTH', (Get-Clipboard -Raw).Trim(), 'User')
SPLUNK_MCP_URL=https://splunk.example.com:8089/services/mcp
SPLUNK_MCP_SEARCH_TOOL=splunk_run_query
SPLUNK_MCP_AUTH=CHANGE_ME

# REST backend. SPLUNK_TOKEN is a Splunk authentication token for the search user.
# Prefer a reference: SPLUNK_TOKEN_REF=file:/run/secrets/splunk-token
SPLUNK_BASE_URL=https://splunk.example.com:8089
SPLUNK_TOKEN=CHANGE_ME

# TLS. A private or self-signed certificate: give its CA here and leave verification on.
# SPLUNK_VERIFY_SSL=false is refused at start-up unless AGENT_DEMO_MODE=true, and is
# logged as a warning at start-up and on every connection.
SPLUNK_CA_BUNDLE=
SPLUNK_VERIFY_SSL=true

# The guard. Every search must name an index, and only these may be named (no wildcards).
# Empty means no search may be run.
SPLUNK_ALLOWED_INDEXES=batch_logs,app_logs
# The longest time range a search may cover (30m, 24h, 7d). Longer ranges are clamped.
SPLUNK_MAX_LOOKBACK=24h
# Every search ends with `| head <this>`. 1 to 1000.
SPLUNK_MAX_RESULTS=100
SPLUNK_TIMEOUT_SECONDS=120

# Demo mode with real Splunk: every other connector stays a mock. Demo mode only.
# LIVE_ADAPTERS=splunk

# Lab only, for scripts/seed_splunk.py (HTTP Event Collector). Not read by the service.
# SPLUNK_HEC_URL=https://localhost:8088
# SPLUNK_HEC_TOKEN=CHANGE_ME
# Set to 1 to run `pytest tests/live -m splunk_live`. It writes events to the lab.
# SPLUNK_LIVE_TESTS=0

# ─── IR360 (MQ Monitoring) ──────────────────────────────────────────
IR360_BASE_URL=https://ir360.example.com/api
IR360_API_KEY=CHANGE_ME
IR360_CLI_PATH=/opt/ir360/bin/ir360
IR360_USE_CLI=false
# TLS verification is always on. *_VERIFY_SSL=false is accepted only with AGENT_DEMO_MODE=true.
IR360_VERIFY_SSL=true

# ─── Autosys ─────────────────────────────────────────────────────────
AUTOSYS_CLI_PATH=autorep
AUTOSYS_ALLOWED_COMMANDS=autorep,job_depends
# The force start (the one change the agent can make). Jobs it may be used on:
# exact names or patterns, comma separated. Empty means none.
AUTOSYS_SENDEVENT_PATH=sendevent
AUTOSYS_FORCE_START_JOBS=

# ─── Actions: what this deployment allows at most ────────────────────
# A tenant's own policy (l1-agent policy set) can only be stricter than these.
# A new tenant starts in shadow mode whatever is set here.
ACTIONS_MAX_TIER=T2            # T0 = this deployment never makes a change
ACTIONS_MAX_AUTONOMY=automatic # shadow | recommend | approval | automatic
# While this file exists, this process makes no change (a local kill switch).
ACTIONS_KILL_SWITCH_FILE=
ACTIONS_SERVICENOW_POLL_SECONDS=30

# ─── Windows Share (SMB) ─────────────────────────────────────────────
WINDOWS_SHARE_ALLOWED_PREFIXES=//fileserver/logs,//batch-server/logs
SMB_USERNAME=readonly_user
SMB_PASSWORD=CHANGE_ME
SMB_DOMAIN=CORP

# ─── Dynatrace (VM Health + Metrics) ──────────────────────────────────
DYNATRACE_BASE_URL=https://your-env.live.dynatrace.com
DYNATRACE_API_TOKEN=CHANGE_ME
DYNATRACE_VERIFY_SSL=true
DYNATRACE_TIMEOUT=30

# ─── Web UI Scraper (Application URL + GCAS Launcher) ────────────────
WEBUI_PAGE_TIMEOUT=30
# Exact host names, https only. An empty list denies every URL.
WEBUI_ALLOWED_DOMAINS=app.example.com,status.example.com
WEBUI_CHROME_BINARY=

# ─── Mainframe TN3270 (MF BEIM ASYNC Status) ────────────────────────
MAINFRAME_HOST=mainframe.example.com
# TN3270 over TLS. MAINFRAME_USE_TLS=false is accepted only with AGENT_DEMO_MODE=true.
MAINFRAME_PORT=992
MAINFRAME_USE_TLS=true
MAINFRAME_ALLOWED_TRANSACTIONS=BEIM,CICS
MAINFRAME_TIMEOUT=30

# ─── Model (optional) ─────────────────────────────────────────────────
# A model only advises: it ranks SOP candidates, points to a value in a ticket,
# writes a labelled hand-over summary and drafts an SOP from an article. It has no
# tools and cannot choose what runs; the engine works with LLM_ENABLED=false.
#
# Setting these makes a provider available to this deployment. It sends nothing
# until a tenant's model policy allows it (l1-agent model set). See RUNBOOK 2.7.
#
# Everything sent is redacted first, but redaction is pattern based.
#
# LLM_PROVIDER=openai_compatible: any endpoint with chat completions and function
# calling that honours a tool_choice naming one function. Verified with NVIDIA NIM:
#   LLM_ENDPOINT=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LLM_PROVIDER=anthropic: the Anthropic Messages API. LLM_ENDPOINT defaults to
# https://api.anthropic.com and LLM_MODEL must be set. Not verified against the live API.
#
# Check a new model with: python -m evals.run --live
LLM_PROVIDER=openai_compatible
LLM_ENDPOINT=https://api.openai.com/v1
# A value, or better a reference read for each request: LLM_API_KEY_REF=vault:...
LLM_API_KEY=CHANGE_ME
LLM_MODEL=gpt-4
# What you state about the endpoint. A tenant's policy is checked against these;
# the agent cannot verify them with the provider. Take them from your contract.
LLM_REGION=
LLM_RETENTION_DAYS=
# US dollars per million tokens, for cost budgets. Leave empty for token budgets only.
LLM_INPUT_PRICE_PER_MTOK=
LLM_OUTPUT_PRICE_PER_MTOK=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_ENABLED=true

# ─── Agent Settings ──────────────────────────────────────────────────
AGENT_SOP_CONFIDENCE_THRESHOLD=0.6
AGENT_MAX_CONCURRENT_INCIDENTS=5
AGENT_RETRY_MAX_ATTEMPTS=3
AGENT_RETRY_BASE_DELAY=1.0
AGENT_CB_FAILURE_THRESHOLD=5
AGENT_CB_RESET_SECONDS=60
AGENT_DEMO_MODE=false
AGENT_LOG_LEVEL=INFO
# Loopback by default. Bind to another address only behind TLS termination.
AGENT_WEBHOOK_HOST=127.0.0.1
AGENT_WEBHOOK_PORT=8080

# ─── Database ───────────────────────────────────────────────────────
# Required outside demo mode. Demo mode with no URL uses a throwaway SQLite file.
# Two roles on purpose:
#   DATABASE_URL            the application role. A login that is a member of the
#                           group role the migration creates (l1_app). Row level
#                           security applies to it. The service refuses to start
#                           as a superuser, a table owner or a BYPASSRLS role.
#   DATABASE_MIGRATION_URL  the role that owns the schema. Used only by
#                           `l1-agent migrate` and `l1-agent tenant create`.
DATABASE_URL=postgresql+asyncpg://l1_app_login:CHANGE_ME@db.example.com:5432/l1agent
DATABASE_MIGRATION_URL=
DATABASE_APP_ROLE=l1_app
# The tenant this deployment signs users into and takes incidents for.
TENANT_SLUG=default

# ─── Workers ────────────────────────────────────────────────────────
# true runs workers inside the API process. For separate worker processes set
# false here and start `l1-agent worker`.
WORKER_EMBEDDED=true
WORKER_POLL_INTERVAL=1.0
# A worker that stops renewing its lease for this long is presumed dead and its
# run is resumed by another worker.
WORKER_VISIBILITY_TIMEOUT=300
WORKER_MAX_ATTEMPTS=3

# ─── Access control ─────────────────────────────────────────────────
# Shared secret for the signed webhook, at least 32 characters. Required outside
# demo mode. The sender sets
#   X-L1-Timestamp: <unix seconds>
#   X-L1-Signature: sha256=<hex HMAC-SHA256 of "<timestamp>.<raw body>">
AGENT_WEBHOOK_SECRET=
AGENT_WEBHOOK_MAX_SKEW_SECONDS=300
# Exact origins allowed to call the API from a browser. Empty means none; '*' is refused.
AGENT_CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=20

# Sign-in with OpenID Connect (authorisation code flow with PKCE).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must be registered with the provider: https://<this service>/auth/callback
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# The ID token claim that lists the user's groups.
OIDC_GROUPS_CLAIM=groups

# Sign-in with SAML 2.0 (needs requirements-saml.txt). Assertions must be signed.
SAML_IDP_METADATA_PATH=
SAML_SP_ENTITY_ID=
# https://<this service>/auth/saml/acs
SAML_ACS_URL=
SAML_GROUPS_ATTRIBUTE=groups

# A user gets roles only through a group mapping:
#   l1-agent roles grant --group <idp group> --role <role>
# Roles: viewer, operator, approver, sop_author, sop_approver, tenant_admin, auditor.
# Machine callers use scoped tokens: l1-agent token create --name x --permission incidents.read
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
# false is accepted only with AGENT_DEMO_MODE=true.
SESSION_COOKIE_SECURE=true

# Emergency administrator for when the identity provider is down. Empty disables it.
# Create the value with `l1-agent breakglass hash`. Every use is audited.
BREAK_GLASS_PASSWORD_HASH=

# ─── Audit log ──────────────────────────────────────────────────────
# Key that signs audit checkpoints, at least 32 characters. Keep checkpoints
# (`l1-agent audit checkpoint`) somewhere the database administrator cannot change.
AUDIT_CHECKPOINT_KEY=

# ─── Escalation routing and email ───────────────────────────────────
# JSON file mapping CI name patterns to L2 teams. Empty uses the packaged example.
L2_ROUTING_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Secrets backend ────────────────────────────────────────────────
# env (default), vault or aws. Fetched secrets are passed to the settings object
# and are never written to the process environment.
SECRETS_BACKEND=env

# ─── Listener TLS (optional) ────────────────────────────────────────
# With both set the service serves HTTPS itself. Otherwise it serves HTTP and TLS
# is expected to end in front of it.
AGENT_TLS_CERT_FILE=
AGENT_TLS_KEY_FILE=

# Demo mode starts with sample SOPs published and the tenant set to act. false leaves
# the demo tenant empty, to walk through set-up from the beginning.
AGENT_DEMO_SEED=true

# ─── The runner (docs/adr/0010-runner-protocol.md) ──────────────────
# embedded (default): connector calls are made in the worker.
# remote: no connector call is made in the API or a worker; a runner makes each one.
RUNNER_MODE=embedded

# Control plane, with RUNNER_MODE=remote. Private keys, as references to PEM files
# made with `l1-agent runner keygen --out <file>`.
#   API and workers: signs every call handed to a runner.
# RUNNER_DISPATCH_KEY_REF=file:/run/secrets/dispatch/dispatch.key
#   Workers only: signs every grant for a write. Do not give it to the API.
# ACTIONS_GRANT_KEY_REF=file:/run/secrets/grant/grant.key

# The runner process (`l1-agent runner run`). It needs no database and reads nothing
# above this section except SECRETS_* and AGENT_LOG_LEVEL.
# RUNNER_CONTROL_PLANE_URL=https://aiops.example.com
# RUNNER_PRIVATE_KEY_REF=file:/run/secrets/runner/runner.key
#   The control plane's public keys: the contents of dispatch.key.pub and grant.key.pub,
#   or a file with <NAME>_FILE. Without the grant key the runner makes no write.
# RUNNER_DISPATCH_PUBLIC_KEY=
# RUNNER_GRANT_PUBLIC_KEY=
#   Leave unset where the control plane serves one tenant: the runner is known by its key.
# RUNNER_ID=
#   A private CA for the control plane's certificate, and a client certificate for an
#   ingress that asks for one.
# RUNNER_CA_FILE=
# RUNNER_CLIENT_CERT_FILE=
# RUNNER_CLIENT_KEY_FILE=

# The runner's own ceiling. Nothing sent to it can raise these.
#   The highest tier it carries out. T0 is reads only.
# RUNNER_MAX_TIER=T0
#   Patterns of capability ids it carries out.
# RUNNER_CAPABILITIES=*
#   JSON: {"autosys": {"force_start_jobs": ["NIGHTLY_*"]}}. A write is made only to a
#   target listed here, whatever the tenant's own list says.
# RUNNER_TARGETS_FILE=/etc/runner/targets.json
#   JSON: {"autosys": {"config": {...}, "secret_refs": {...}}}. For a connector listed
#   here, the connection the control plane sends is ignored.
# RUNNER_CONNECTIONS_FILE=/etc/runner/connections.json
#   Where a credential reference sent by the control plane may point. Empty: nowhere.
# RUNNER_SECRET_REF_PREFIXES=file:/run/secrets/connectors/,vault:connectors/
#   While this file exists the runner makes no write.
# RUNNER_KILL_SWITCH_FILE=/etc/runner/stop
# RUNNER_CONCURRENCY=4
#   Demo mode only: the runner holds the mock connectors.
# RUNNER_MOCK_CONNECTORS=false
