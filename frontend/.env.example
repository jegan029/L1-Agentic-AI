# Leave VITE_API_BASE_URL empty in development: the Vite proxy serves /api/* from the
# same origin and adds the bearer token on the server side.
VITE_API_BASE_URL=

# Dev proxy only (never bundled into the browser build)
L1_API_TARGET=http://127.0.0.1:8080
L1_API_TOKEN=

# Branding. All optional; defaults are neutral.
VITE_BRAND_PRODUCT=L1 Engineer Agent
VITE_BRAND_ORG=
VITE_BRAND_BANNER=
VITE_BRAND_LOGO=
VITE_BRAND_FOOTER=L1 Engineer Agent
